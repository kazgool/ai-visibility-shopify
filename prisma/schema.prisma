// AI Visibility All-in-One — operational database (ARCHITECTURE §4).
// Merchant-authored data lives in Shopify metafields, never here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Migrations must bypass the Neon pooler: prisma migrate takes a Postgres
  // advisory lock, and through PgBouncer that lock lands on a pooled backend
  // that outlives the process - the next migrate then times out with P1002.
  // Queries stay on the pooler; only migrate/db push use this.
  directUrl = env("DIRECT_URL")
}

// Shopify session storage (PrismaSessionStorage adapter).
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model Shop {
  id             String    @id @default(uuid())
  domain         String    @unique
  installedAt    DateTime  @default(now())
  uninstalledAt  DateTime?
  plan           String    @default("none")
  metafieldsInit Boolean   @default(false)
  // Free-tier counter (FREE-TIER-SPEC §4): lives on the Shop row so it
  // survives uninstall and reinstall, keyed by domain. Incremented only
  // after a successful write - a failed write must not consume one of the
  // three.
  freeProductsUsed Int     @default(0)

  settings      Setting[]
  jobRuns       JobRun[]
  mirrorCache   MirrorCache[]
  themeScans    ThemeScan[]
  crawlerChecks CrawlerCheck[]
  seoScans      SeoScan[]
  seoSnapshots  SeoSnapshot[]
}

model Setting {
  id     String @id @default(uuid())
  shopId String
  key    String
  value  String // dictionary text, stopword additions, module toggles (JSON where structured)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, key])
}

model JobRun {
  id         String    @id @default(uuid())
  shopId     String
  kind       String // bulk_extract | dry_run | alt_text | crawler_check
  status     String    @default("queued") // queued | running | done | failed
  // A queued job carried no time at all, so nothing on the server could tell
  // how long it had been waiting, and the dashboard had to count in the
  // browser - which restarts on every refresh and therefore never fired.
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?
  progress   Int       @default(0)
  total      Int       @default(0)
  report     Json?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, kind])
}

model MirrorCache {
  id        String   @id @default(uuid())
  shopId    String
  handle    String
  // The product GID this row mirrors. Nullable because rows written before
  // this column existed have no value; new writes always set it. Lets a
  // deletion or a handle change be resolved by product id, which is what
  // both the products/delete and products/update webhooks carry reliably -
  // the handle on those payloads can be stale or absent.
  productId String?
  body      String // rendered markdown, served as-is by the proxy route
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, handle])
  @@index([shopId, productId])
}

model ThemeScan {
  id           String   @id @default(uuid())
  shopId       String
  themeId      String
  hasProductLd Boolean?
  detail       Json?
  scannedAt    DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, themeId])
}

model CrawlerCheck {
  id        String   @id @default(uuid())
  shopId    String
  agent     String // GPTBot, OAI-SearchBot, ChatGPT-User, Claude-SearchBot, PerplexityBot
  status    Int?
  cause     String? // password_page | bot_app | cloudflare | robots | ok | unknown
  checkedAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, checkedAt])
}

// Phase 0 raw logging only (CRAWLER-HITS-SPEC §3). Answers whether the app
// proxy forwards the original user agent and a usable IP, and whether
// Shopify's edge caches the response. No aggregation, no UI reads this yet.
model CrawlerHit {
  id     BigInt   @id @default(autoincrement())
  shopId String
  agent  String // as sent, untrimmed
  ip     String?
  handle String? // product handle, null for key files
  path   String
  status Int
  at     DateTime @default(now())

  // Diagnostic only, temporary (see clientIp() in proxy.$.tsx): compact JSON
  // of the candidate forwarding headers as received, to determine whether a
  // real client address is ever available behind Fly and Shopify's edge.
  forwarding String?

  @@index([shopId, at])
}

// Self-measured latency, so Built for Shopify numbers are known before Shopify's email.
model RequestMetric {
  id       BigInt   @id @default(autoincrement())
  path     String
  ms       Int
  ok       Boolean  @default(true)
  region   String?
  at       DateTime @default(now())

  @@index([at])
}

// One row per shop and product: what a crawler sees on that product's page,
// and what the catalogue read says about the product's own fields
// (PRD-SEO-PER-PRODUCT section 2.2). Operational only - every merchant-
// authored value it describes lives in Shopify, and losing this table costs
// a rescan, never a merchant's work.
//
// Two sources, kept apart on purpose. Source A (the bulk catalogue read)
// fills `handle`, `findings`, `offer` and `bulkAt`. Source B (one GET of the
// public page) fills `nodes`, `status`, `canonical`, `noindex`, `appBlock`,
// `cacheControl` and `scannedAt`. A null `scannedAt` means the page has never
// been read, which the screen says as "not yet read" and never as "no
// finding".
model SeoScan {
  id        String  @id @default(uuid())
  shopId    String
  productId String
  handle    String?

  // Source A.
  bulkAt   DateTime?
  findings Json?
  // What the product's variants say about availability and price, so source
  // B's comparison has something to compare against without a second
  // catalogue read. Shape: OfferFacts in app/services/seo-scan.ts.
  offer    Json?

  // Source B. Untouched by build step 2; every one of them is null until the
  // nightly page scan exists.
  scannedAt    DateTime?
  nodes        Json?
  status       String?
  canonical    String?
  noindex      Boolean?
  appBlock     String?
  cacheControl String?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, productId])
  // The nightly scan's order is its cursor: never scanned first, then oldest
  // first. Postgres sorts NULLs LAST on ASC, so the query asks for
  // `nulls: "first"` explicitly (seo-page.server.ts); this index serves it.
  // The comment written here in build step 2 said the opposite and was wrong.
  @@index([shopId, scannedAt])
}

// The before-snapshot of a paid SEO engagement (PRD-SEO-FULL-ONPAGE §1.1).
//
// One row per shop, written once inside grantSeoUnlock before the key is
// stored, and never updated afterwards. Without it no screen can say what the
// engagement did: "50 of 50 have a meta title" is indistinguishable from "it
// was always so".
//
// `shopId` is unique so the guarantee is Postgres's and not only the writing
// code's, and every column is a count rather than a copy of the catalogue -
// the row holds no merchant text at all.
model SeoSnapshot {
  id      String   @id @default(uuid())
  shopId  String
  takenAt DateTime @default(now())
  // "unlock" - taken at the moment the key was entered, so it is a true
  // before. "manual" - taken by hand for a shop whose key predates this
  // table, so the card must say "since <date>" and never "since the start".
  // "current" - not a snapshot at all: the same figures as they stand now,
  // rewritten by every catalogue pass, so the card can show a difference
  // without a screen load paying for a bulk operation. Kept in this table and
  // in this shape deliberately - one function computes both halves over the
  // same fields, so a difference between them cannot be an artefact of two
  // different readings of one catalogue.
  takenBy String

  // Source A: the same bulk read the catalogue pass runs, at that moment.
  products            Int
  metaTitleSet        Int
  metaTitleOurs       Int
  metaDescriptionSet  Int
  metaDescriptionOurs Int
  withBarcode         Int
  withVendor          Int
  withSku             Int
  withImage           Int

  // Page-derived, from the SeoScan rows as they stood. Null - never 0 - when
  // no page had been read at that moment: a zero here would be read as "the
  // theme emitted nothing", which is a claim about the theme that nobody made.
  productNodeTheme Int?
  productNodeNone  Int?
  /** The distinct JSON-LD types the theme emitted, as a sorted string list. */
  themeNodeTypes   Json?

  /** Count per check code from SeoScan at that moment. Null when the shop had
   * no SeoScan rows at all, so an empty object can keep meaning "rows existed
   * and none carried a finding". */
  findingsByCode Json?
  /** How many rows had a page read at snapshot time. 0 is honest here: it is
   * a count of rows, not a measurement of a page. */
  pagesRead      Int

  /** "Written by this app since then", on the `current` row only: per state
   * key, the count of `source: "auto"` entries stamped after the snapshot,
   * with the earliest and latest timestamp. Null on a before row, and null on
   * a current row for a shop with no snapshot to count since. */
  writtenSince   Json?
  /** Which snapshot `writtenSince` was counted against. The card refuses to
   * show the block unless this equals the before row's takenAt: a snapshot
   * taken after the last catalogue pass leaves a figure counted from a
   * different date, and a number under the wrong date is worse than none. */
  writtenSinceAt DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, takenBy])
}
