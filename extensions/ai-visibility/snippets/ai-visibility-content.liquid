{%- comment -%}
  AI Visibility - visible content (PRD-AI-READABILITY P0.1, P0.2, P1.1).

  What the app wrote for a product - summary, facts, who it suits, buyer
  questions - printed as text on the page itself. Every AI system that reads
  a store reads rendered text: the crawlers that build training data, the
  ones that build search indexes, and the agents that fetch a page when a
  user asks. JSON-LD in the head and the plain-text mirror under the app
  proxy reach none of them reliably; this does.

  One snippet so the markup exists once. Rendered by the automatic embed
  (blocks/ai-visibility-content.liquid) and by the block a merchant places
  by hand (blocks/product-content.liquid). A rendered snippet sees only what
  it is given, so both pass the page object and their own settings:

    kind            'product' or 'collection'. Passed, not inferred: a
                    product reached through /collections/x/products/y has a
                    collection in context as well as a product.
    product         the product, when kind is 'product'
    collection      the collection, when kind is 'collection'
    shop_url        shop.url
    heading         text; nothing printed when blank
    heading_level   'h2' or 'h3'; questions sit one level below it
    show_summary, show_facts, show_fit, show_questions, show_links

  Rules, all from the PRD and CLAUDE.md:
  - Renders nothing at all - no wrapper, no heading, no whitespace - unless
    at least one part has content and is switched on. A heading over an
    empty box, or a box holding only two links, is the "0 facts" line the
    merchant was promised never to see.
  - Every value through `escape`: a fact reading "<30 cm & light" prints as
    text, never as markup.
  - Inline styles are spacing, a max-width and the two-column layout of the
    facts list, which P0.1 names. No font, no colour: the block takes the
    theme's own, so it reads as part of the page, not as an advert.
  - No JavaScript, no request, nothing that executes.
{%- endcomment -%}

{%- assign av_h = 'h2' -%}
{%- assign av_hq = 'h3' -%}
{%- if heading_level == 'h3' -%}
  {%- assign av_h = 'h3' -%}
  {%- assign av_hq = 'h4' -%}
{%- endif -%}

{%- if kind == 'product' and product -%}
  {%- assign av_summary = product.metafields['$app'].summary.value -%}
  {%- assign av_facts = product.metafields['$app'].facts.value -%}
  {%- assign av_fit = product.metafields['$app'].fit_for.value -%}
  {%- assign av_questions = product.metafields['$app'].questions.value -%}

  {%- assign av_show_summary = false -%}
  {%- if show_summary and av_summary != blank -%}{%- assign av_show_summary = true -%}{%- endif -%}
  {%- assign av_show_facts = false -%}
  {%- if show_facts and av_facts and av_facts.size > 0 -%}{%- assign av_show_facts = true -%}{%- endif -%}
  {%- assign av_show_fit = false -%}
  {%- if show_fit and av_fit != blank -%}{%- assign av_show_fit = true -%}{%- endif -%}
  {%- assign av_show_questions = false -%}
  {%- if show_questions and av_questions and av_questions.size > 0 -%}{%- assign av_show_questions = true -%}{%- endif -%}

  {%- if av_show_summary or av_show_facts or av_show_fit or av_show_questions -%}
    <section class="ai-visibility-content" style="margin:2rem 0;max-width:72rem;">
      {%- if heading != blank -%}
        <{{ av_h }} style="margin:0 0 0.75rem;">{{ heading | escape }}</{{ av_h }}>
      {%- endif -%}
      {%- if av_show_summary -%}
        <p style="margin:0 0 1rem;">{{ av_summary | escape }}</p>
      {%- endif -%}
      {%- if av_show_facts -%}
        {%- comment -%}
          Label and value exactly as stored in $app.facts, in the stored order,
          which is the order the plain-text mirror prints them in.
        {%- endcomment -%}
        <dl class="ai-visibility-content__facts" style="display:grid;grid-template-columns:minmax(8rem,max-content) 1fr;gap:0.25rem 1.5rem;margin:0 0 1rem;">
          {%- for fact in av_facts -%}
            <dt style="margin:0;">{{ fact.k | escape }}</dt>
            <dd style="margin:0;">{{ fact.v | escape }}</dd>
          {%- endfor -%}
        </dl>
      {%- endif -%}
      {%- if av_show_fit -%}
        <p style="margin:0 0 1rem;">Suits: {{ av_fit | escape }}</p>
      {%- endif -%}
      {%- if av_show_questions -%}
        {%- for qa in av_questions -%}
          <{{ av_hq }} style="margin:1rem 0 0.25rem;">{{ qa.q | escape }}</{{ av_hq }}>
          <p style="margin:0 0 0.5rem;">{{ qa.a | escape }}</p>
        {%- endfor -%}
        {%- comment -%}
          FAQPage, here and only here: right after the questions it describes,
          and only when they are shown, so the markup never describes text the
          page does not carry (P0.3). The head block used to emit it whatever
          this block showed. No rich result follows from it - Google ended FAQ
          rich results on 7 May 2026 - and nothing in this app may imply one;
          it is for the reader parsing the page.
        {%- endcomment -%}
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "https://mrdigital.ro/ns/ai-visibility": "1",
            "mainEntity": [
              {%- for qa in av_questions -%}
                {
                  "@type": "Question",
                  "name": {{ qa.q | json }},
                  "acceptedAnswer": { "@type": "Answer", "text": {{ qa.a | json }} }
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          }
        </script>
      {%- endif -%}
      {%- if show_links -%}
        <p style="margin:1rem 0 0;"><a href="{{ shop_url }}/apps/ai-visibility/{{ product.handle }}">Plain-text version of this page</a></p>
        <p style="margin:0.25rem 0 0;"><a href="{{ shop_url }}/apps/ai-visibility/llms.txt">All products as plain text</a></p>
      {%- endif -%}
    </section>
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Collection pages (P0.2): summary, what to choose between, buyer questions,
  then the comparison table, in that order. A collection has no plain-text
  page of its own, so only the index link is offered. Same empty rule: one
  switched-on part with content, or nothing at all.
{%- endcomment -%}
{%- if kind == 'collection' and collection -%}
  {%- assign av_c_summary = collection.metafields['$app'].summary.value -%}
  {%- assign av_c_criteria = collection.metafields['$app'].criteria.value -%}
  {%- assign av_c_questions = collection.metafields['$app'].questions.value -%}
  {%- assign av_c_table = collection.metafields['$app'].table.value -%}

  {%- assign av_show_summary = false -%}
  {%- if show_summary and av_c_summary != blank -%}{%- assign av_show_summary = true -%}{%- endif -%}
  {%- assign av_show_criteria = false -%}
  {%- if show_criteria and av_c_criteria and av_c_criteria.size > 0 -%}{%- assign av_show_criteria = true -%}{%- endif -%}
  {%- assign av_show_questions = false -%}
  {%- if show_questions and av_c_questions and av_c_questions.size > 0 -%}{%- assign av_show_questions = true -%}{%- endif -%}
  {%- assign av_show_table = false -%}
  {%- if show_table and av_c_table and av_c_table.columns.size > 0 and av_c_table.rows.size > 0 -%}{%- assign av_show_table = true -%}{%- endif -%}

  {%- if av_show_summary or av_show_criteria or av_show_questions or av_show_table -%}
    <section class="ai-visibility-content" style="margin:2rem 0;max-width:72rem;">
      {%- if heading != blank -%}
        <{{ av_h }} style="margin:0 0 0.75rem;">{{ heading | escape }}</{{ av_h }}>
      {%- endif -%}
      {%- if av_show_summary -%}
        <p style="margin:0 0 1rem;">{{ av_c_summary | escape }}</p>
      {%- endif -%}
      {%- if av_show_criteria -%}
        <ul style="margin:0 0 1rem;padding-left:1.25rem;">
          {%- for item in av_c_criteria -%}
            <li>{{ item | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if av_show_questions -%}
        {%- for qa in av_c_questions -%}
          <{{ av_hq }} style="margin:1rem 0 0.25rem;">{{ qa.q | escape }}</{{ av_hq }}>
          <p style="margin:0 0 0.5rem;">{{ qa.a | escape }}</p>
        {%- endfor -%}
        {%- comment -%} FAQPage after the questions it describes, as on product pages. {%- endcomment -%}
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "https://mrdigital.ro/ns/ai-visibility": "1",
            "mainEntity": [
              {%- for qa in av_c_questions -%}
                {
                  "@type": "Question",
                  "name": {{ qa.q | json }},
                  "acceptedAnswer": { "@type": "Answer", "text": {{ qa.a | json }} }
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          }
        </script>
      {%- endif -%}
      {%- if av_show_table -%}
        {%- assign av_caption = collection.title | append: ': product comparison' -%}
        <div style="margin:1rem 0 0;">
          {%- render 'ai-visibility-table', table: av_c_table, caption: av_caption, shop_url: shop_url, product_column: 'Product' -%}
        </div>
      {%- endif -%}
      {%- if show_links -%}
        <p style="margin:1rem 0 0;"><a href="{{ shop_url }}/apps/ai-visibility/llms.txt">All products as plain text</a></p>
      {%- endif -%}
    </section>
  {%- endif -%}
{%- endif -%}
