{% comment %}
  AI Visibility content - app embed, automatic (PRD-AI-READABILITY P0.1).

  Prints what the app wrote for a product as visible text in the page body,
  so a person, a crawler and an AI agent reading the page all see it without
  the merchant editing the theme. Switched on once in the theme editor under
  App embeds; every product then gets it, and a product with nothing to say
  gets nothing at all. The markup lives in snippets/ai-visibility-content.liquid,
  shared with the block a merchant places by hand.

  "I placed the content block myself" turns this off on product pages.
  Liquid variables do not cross block boundaries and Shopify documents no way
  for an app embed to see an app block of the same extension on the page, so
  this is a setting the merchant ticks, not a detection this block pretends
  to make.

  Static markup only: no JavaScript, no fetch, no external request.
{% endcomment %}

{%- unless block.settings.manual_placement -%}
  {%- if template.name == 'product' and product -%}
    {%- render 'ai-visibility-content',
      kind: 'product',
      product: product,
      shop_url: shop.url,
      heading: block.settings.heading,
      heading_level: block.settings.heading_level,
      show_summary: block.settings.show_summary,
      show_facts: block.settings.show_facts,
      show_fit: block.settings.show_fit,
      show_questions: block.settings.show_questions,
      show_links: block.settings.show_links
    -%}
  {%- endif -%}
{%- endunless -%}

{%- comment -%}
  Collection pages (P0.2). The same embed rather than a second one: one
  toggle for the merchant, one set of settings. When "I placed the content
  block myself" is ticked, the page is taken to carry the comparison-table
  block, which already shows the summary, what to choose between and the
  table; only the questions, which that block cannot show, stay here.
{%- endcomment -%}
{%- if template.name == 'collection' and collection -%}
  {%- if block.settings.manual_placement -%}
    {%- render 'ai-visibility-content',
      kind: 'collection',
      collection: collection,
      shop_url: shop.url,
      heading: block.settings.collection_heading,
      heading_level: block.settings.heading_level,
      show_summary: false,
      show_criteria: false,
      show_questions: block.settings.show_questions,
      show_table: false,
      show_links: false
    -%}
  {%- else -%}
    {%- render 'ai-visibility-content',
      kind: 'collection',
      collection: collection,
      shop_url: shop.url,
      heading: block.settings.collection_heading,
      heading_level: block.settings.heading_level,
      show_summary: block.settings.show_summary,
      show_criteria: block.settings.show_criteria,
      show_questions: block.settings.show_questions,
      show_table: block.settings.show_table,
      show_links: block.settings.show_links
    -%}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "AI Visibility content",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:content.settings.heading.label",
      "info": "t:content.settings.heading.info"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "t:content.settings.heading_level.label",
      "info": "t:content.settings.heading_level.info",
      "options": [
        { "value": "h2", "label": "t:content.settings.heading_level.options.h2" },
        { "value": "h3", "label": "t:content.settings.heading_level.options.h3" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "t:content.settings.show_summary.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_facts",
      "label": "t:content.settings.show_facts.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_fit",
      "label": "t:content.settings.show_fit.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_questions",
      "label": "t:content.settings.show_questions.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_links",
      "label": "t:content.settings.show_links.label",
      "default": true
    },
    {
      "type": "text",
      "id": "collection_heading",
      "label": "t:content.settings.collection_heading.label",
      "info": "t:content.settings.collection_heading.info"
    },
    {
      "type": "checkbox",
      "id": "show_criteria",
      "label": "t:content.settings.show_criteria.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_table",
      "label": "t:content.settings.show_table.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "manual_placement",
      "label": "t:content.settings.manual_placement.label",
      "info": "t:content.settings.manual_placement.info",
      "default": false
    }
  ]
}
{% endschema %}
