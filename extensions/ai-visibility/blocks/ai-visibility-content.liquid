{% comment %}
  AI Visibility content - app embed, automatic (PRD-AI-READABILITY P0.1).

  Prints what the app wrote for a product as visible text in the page body,
  so a person, a crawler and an AI agent reading the page all see it without
  the merchant editing the theme. Switched on once in the theme editor under
  App embeds; every product then gets it, and a product with nothing to say
  gets nothing at all. The markup lives in snippets/ai-visibility-content.liquid,
  shared with the block a merchant places by hand.

  "I placed the content block myself" turns this off on product pages.
  Liquid variables do not cross block boundaries and Shopify documents no way
  for an app embed to see an app block of the same extension on the page, so
  this is a setting the merchant ticks, not a detection this block pretends
  to make.

  Static markup only: no JavaScript, no fetch, no external request.
{% endcomment %}

{%- unless block.settings.manual_placement -%}
  {%- if template.name == 'product' and product -%}
    {%- render 'ai-visibility-content',
      kind: 'product',
      product: product,
      shop_url: shop.url,
      heading: block.settings.heading,
      heading_level: block.settings.heading_level,
      show_summary: block.settings.show_summary,
      show_facts: block.settings.show_facts,
      show_fit: block.settings.show_fit,
      show_questions: block.settings.show_questions,
      show_links: block.settings.show_links
    -%}
  {%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "AI Visibility content",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About this product"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "info": "Questions sit one level below it.",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show the summary",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_facts",
      "label": "Show the key facts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_fit",
      "label": "Show who it suits",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_questions",
      "label": "Show buyer questions and answers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_links",
      "label": "Show links to the plain-text versions",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "manual_placement",
      "label": "I placed the content block myself; hide the automatic one",
      "default": false
    }
  ]
}
{% endschema %}
