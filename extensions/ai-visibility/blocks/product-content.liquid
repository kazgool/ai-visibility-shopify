{% comment %}
  AI Visibility details - app block, placed by the merchant (PRD-AI-READABILITY
  P1.1).

  The same content as the automatic embed (blocks/ai-visibility-content.liquid)
  and the same markup, from the same snippet, for a merchant who wants it in a
  particular place on the product template: under the description, beside
  the specs tab, wherever it fits the theme.

  The embed cannot see this block. Liquid variables do not cross block
  boundaries and Shopify documents no way for an app embed to detect an app
  block of the same extension, so nothing here pretends to. The merchant who
  places this block ticks "I placed the content block myself" on the embed,
  and SUPPORT.md says so. Without the tick the page shows the content twice,
  which is visible and fixable; a detection that silently failed would not be.

  Static markup only: no JavaScript, no fetch, no external request.
{% endcomment %}

{%- if product -%}
  {%- render 'ai-visibility-content',
    kind: 'product',
    product: product,
    shop_url: shop.url,
    heading: block.settings.heading,
    heading_level: block.settings.heading_level,
    show_summary: block.settings.show_summary,
    show_facts: block.settings.show_facts,
    show_fit: block.settings.show_fit,
    show_questions: block.settings.show_questions,
    show_links: block.settings.show_links
  -%}
{%- endif -%}

{% schema %}
{
  "name": "AI Visibility details",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About this product"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "info": "Questions sit one level below it.",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show the summary",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_facts",
      "label": "Show the key facts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_fit",
      "label": "Show who it suits",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_questions",
      "label": "Show buyer questions and answers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_links",
      "label": "Show links to the plain-text versions",
      "default": true
    }
  ]
}
{% endschema %}
